# ── DataForge × Rime — Break My Voice Agent ────────────────────────────────
# Copy to .env (agent/.env is gitignored). Never commit a real value here.
# Every provider credential stays server-side: the browser WebSocket API cannot set
# Authorization headers, and Rime's docs require the bearer token on the handshake.

# --- Rime (required: this is the judged spoken-output provider) -------------
RIME_API_KEY=
# Model + voice must be a published combination. Rime does not reliably reject a bad
# triple (it can silently serve another voice), so agent/config.py validates it locally.
# Valid models for livekit-plugins-rime 1.7.1: coda | mistv3 | mistv2
RIME_MODEL=coda
RIME_SPEAKER=astra
RIME_LANG=en
# mistv3 is documented as the lowest time-to-first-audio; coda is Rime's default model.
# To compare: RIME_MODEL=mistv3 RIME_SPEAKER=astra
RIME_SAMPLE_RATE=22050
RIME_SPEED_ALPHA=1.0
RIME_REDUCE_LATENCY=1
# 1 = stream over wss://users-ws.rime.ai/ws3 (word timestamps + `clear` interruption).
# 0 = HTTP streaming to https://users.rime.ai/v1/rime-tts (no word timestamps).
RIME_USE_WEBSOCKET=1
RIME_SEGMENT=bySentence
RIME_REGION=global

# --- LiveKit (realtime transport) ------------------------------------------
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# 1 = livekit-cli dev mode: ephemeral room + token, no project keys. Best for the demo.
LIVEKIT_DEV=1

# --- STT (spec §8: do not build this) --------------------------------------
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3

# --- LLM slot --------------------------------------------------------------
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini

# --- Experiment knobs (these are what the metrics depend on) ---------------
# Latency of the deliberately slow tool (spec §11). Dial it up on stage to widen the
# race window; the fixture overrides it per case.
TOOL_DELAY_MS=1500
# Modelled round trip of Rime's `clear` operation, used by the deterministic simulator
# only. Labeled "simulated" in every result. Ignored by --live runs.
RIME_CLEAR_RTT_MS=40
# How long barge-in detection takes before the app learns the user spoke.
INTERRUPTION_DETECT_MS=120
# Approximate ms of audible speech per word (sizes the queued backlog in sim).
MS_PER_WORD=225
PLAYBACK_BACKLOG_MS=600
# Data-channel topic the browser subscribes to for the event timeline.
TELEMETRY_TOPIC=vime.timeline

# --- Local dev server (token mint + Lab mode replay) -----------------------
AGENT_HOST=0.0.0.0
AGENT_PORT=8080
LOG_LEVEL=info
