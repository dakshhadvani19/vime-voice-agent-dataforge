{
  "name": "break-my-voice-agent-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync:results": "node -e \"const f=require('fs');f.mkdirSync('src/generated',{recursive:true});f.copyFileSync('../evaluation/results/latest.json','src/generated/latest.json')\"",
    "predev": "npm run --silent sync:results",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run --silent sync:results",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "lint": "eslint src scripts --max-warnings 0",
    "smoke:reducer": "esbuild scripts/reducer_smoke.mts --bundle --platform=node --format=esm --outfile=node_modules/.cache/smoke.mjs --log-level=error && node node_modules/.cache/smoke.mjs"
  },
  "dependencies": {
    "livekit-client": "^2.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^5.4.11"
  }
}
