# --- secrets (spec §22: no secrets committed) -------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials.json
.livekit/

# --- python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
.venv-*/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.coverage
htmlcov/
dist/
build/

# --- node / vite ------------------------------------------------------------
node_modules/
frontend/dist/
frontend/.vite/
*.local
npm-debug.log*
yarn-error.log*
.vercel

# --- generated artifacts: keep the latest evidence, drop raw audio ----------
agent/media/*.wav
agent/media/*.mp3
agent/media/*.pcm
*.log
.DS_Store
Thumbs.db

# --- editors ----------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
.claude/
.qoder/

# Timestamped evaluation runs are regenerable; only the "latest" pair is evidence we cite.
evaluation/results/*-simulated.json
evaluation/results/*-live.json
evaluation/results/*.md
!evaluation/results/latest.md

# --- build caches -----------------------------------------------------------
*.tsbuildinfo
